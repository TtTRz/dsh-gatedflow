{
  "name": "@gatedflow/dsh",
  "version": "0.1.0",
  "description": "DeepSeek Harness adapter for the gatedflow engine: gf_* tools, gate panel UI, anti-bypass guard, and filesystem persistence.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/gateway.js",
  "types": "./lib/gateway.d.ts",
  "exports": {
    ".": {
      "types": "./lib/gateway.d.ts",
      "default": "./lib/gateway.js"
    },
    "./host": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./lib": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gatedflow/engine": "file:../engine",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "react": "^18.0.0",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "workflow",
    "gates",
    "gatedflow"
  ],
  "author": "TtTRz",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
